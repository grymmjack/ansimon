#!/usr/bin/env bash
# ansimon — one-command ANSI art generator.
# Makes sure the ComfyUI server is up, then hands your prompt to ansimon.py.
set -euo pipefail

COMFY="$HOME/ComfyUI"
PY="$COMFY/.venv/bin/python"
URL="http://127.0.0.1:8188"

up() { curl -fsS "$URL/system_stats" >/dev/null 2>&1; }

# Help / listings / no args don't touch the GPU — never start the server.
needs_server=1
case " $* " in
    *" -h "*|*" --help "*|*" --list-charsets "*|*" --list-palettes "*|*" --list-styles "*|*" --doctor "*)
        needs_server=0 ;;
esac
[ "$#" -eq 0 ] && needs_server=0

# A remote render target (--server NAME|HOST, or $ANSIMON_SERVER) is managed elsewhere
# (e.g. another box on the LAN) — don't try to start a local ComfyUI for it.
TARGET="${ANSIMON_SERVER:-}"
prev=""
for arg in "$@"; do
    [ "$prev" = "--server" ] && TARGET="$arg"
    prev="$arg"
done
if [ -n "$TARGET" ]; then
    case "$TARGET" in
        local|localhost|127.0.0.1*|http://127.0.0.1*|http://localhost*) ;;
        *) needs_server=0 ;;
    esac
fi

if [ "$needs_server" = 1 ] && ! up; then
    echo "[ansimon] ComfyUI server isn't running — starting it (first run ~15s)..."
    nohup "$HOME/launch-comfyui.sh" >"$COMFY/server.log" 2>&1 &
    for _ in $(seq 1 90); do
        up && break
        sleep 1
    done
    if ! up; then
        echo "[ansimon] server didn't come up. Check $COMFY/server.log" >&2
        exit 1
    fi
    echo "[ansimon] server ready."
fi

exec "$PY" "$COMFY/ansimon.py" "$@"
